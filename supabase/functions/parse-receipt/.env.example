# Copy to supabase/functions/.env.local (git-ignored) and run:
#   npx supabase functions serve --env-file supabase/functions/.env.local
ANTHROPIC_API_KEY=
# Chosen at the M2 checkpoint (SPEC 7.7). Rerun the eval before changing it.
ANTHROPIC_MODEL=claude-sonnet-5
MAX_IMAGE_BYTES=5000000
# Optional: send model calls to a stub or proxy instead of https://api.anthropic.com.
# ANTHROPIC_BASE_URL=
