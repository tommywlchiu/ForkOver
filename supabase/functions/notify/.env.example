# Copy to supabase/functions/.env.local (git-ignored) and run:
#   npx supabase functions serve --env-file supabase/functions/.env.local
#
# Must match the `x-notify-secret` header value baked into the webhook trigger
# (supabase/migrations/20261013000200_notify_webhook.sql) for the local stack to work -
# generate a fresh value for any other environment and update both.
NOTIFY_WEBHOOK_SECRET=
